# App Configuration
LOG_FILE=logs/bot.log
PACKAGE_NAME=com.supercell.clashroyale
THRESHOLD=0.8

# Device Selection
# Serial of the ADB device to control (from `adb devices`).
# Leave empty to auto-select when only one device is connected;
# required if multiple devices are connected at once.
DEVICE_SERIAL=

# Lock screen PIN, only needed if the device has a numeric PIN lock.
# Leave empty if the device has no lock or only a swipe-to-unlock screen.
# Stored in plaintext here, keep this .env file out of version control.
DEVICE_PIN=

# Paths
TEMPLATE_PATH=assets/templates/battle_button.png
SCREENSHOT_PATH=assets/debug/screen.png

# Notifications
# Discord webhook URL (Server Settings > Integrations > Webhooks) used to notify
# you when the bot claims the daily free card. Leave empty to disable notifications.
DISCORD_WEBHOOK_URL=
